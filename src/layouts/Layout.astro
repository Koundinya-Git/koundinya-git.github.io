---
import '../styles/global.css';
import { siteConfig } from '../siteConfig';
import Navbar from '../components/Navbar';
import CommandPalette from '../components/CommandPalette';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = siteConfig.name, 
  description = siteConfig.description 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.domain);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbjl+Uvtt6fG0ZX6We369i09eJ9LqxGdi5+vxXG6E8" crossorigin="anonymous">
  </head>
  <body>
    <!-- Header / Nav placeholder -->
    <header>
      <Navbar client:load />
    </header>

    <!-- Main Content -->
    <main class="container">
      <slot />
    </main>

    <CommandPalette client:load />

    <!-- Footer -->
    <footer class="container" style="padding-top: 2rem; padding-bottom: 2rem; margin-top: 4rem; border-top: 1px solid var(--surface-color-border);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <p class="mono" style="font-size: 0.9rem; color: var(--text-secondary);">
          {siteConfig.name} © {new Date().getFullYear()}
        </p>
        <div style="display: flex; gap: 1.5rem;" class="mono text-sm">
          <a href={siteConfig.socialLinks.github} target="_blank" rel="noreferrer" class="text-secondary hover:text-accent">GitHub</a>
          <a href={siteConfig.socialLinks.orcid} target="_blank" rel="noreferrer" class="text-secondary hover:text-accent">ORCID</a>
          <a href={`mailto:${siteConfig.email}`} class="text-secondary hover:text-accent">Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
