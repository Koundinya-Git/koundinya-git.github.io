---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import { Code, Star, GitFork, Book } from 'lucide-react';

let repos = [];
try {
  // If data exists, use it. Otherwise empty array.
  // We'll use a dynamic import to avoid failing if file doesn't exist yet
  // but Astro handles JSON imports well if they are in src/
  // For safety since it's generated by github actions, let's try a direct read or fallback
  const fs = await import('fs/promises');
  const path = await import('path');
  const dataPath = path.resolve('./src/data/github.json');
  const data = await fs.readFile(dataPath, 'utf-8');
  repos = JSON.parse(data);
} catch (e) {
  // Data not available yet
}
---

<Layout title={`GitHub | ${siteConfig.name}`}>
  <div style="padding-top: 6rem; padding-bottom: 4rem; max-width: 900px; margin: 0 auto;">
    <header style="margin-bottom: 3rem; text-align: center;">
      <div class="flex items-center justify-center gap-4 mb-4">
        <Code size={48} class="text-accent" />
        <h1 class="text-4xl font-bold mono">GitHub Activity</h1>
      </div>
      <p class="text-secondary mono">Open source contributions and repositories.</p>
    </header>

    {repos.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
        {repos.map((repo: any) => (
          <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="block-panel group" style="text-decoration: none; display: flex; flex-direction: column;">
            <h2 class="mono text-primary mb-2 group-hover:text-accent flex items-center gap-2 text-lg">
              <Book size={18} /> {repo.name}
            </h2>
            <p class="text-secondary mb-4 flex-grow" style="font-size: 0.9rem;">
              {repo.description || 'No description provided.'}
            </p>
            <div class="flex items-center gap-4 text-xs mono text-secondary mt-auto">
              {repo.language && (
                <span class="flex items-center gap-1">
                  <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent-primary); display: inline-block;"></span>
                  {repo.language}
                </span>
              )}
              <span class="flex items-center gap-1"><Star size={14} /> {repo.stargazers_count}</span>
              <span class="flex items-center gap-1"><GitFork size={14} /> {repo.forks_count}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="block-panel text-center" style="padding: 3rem;">
        <p class="text-secondary mono">GitHub data is currently syncing or unavailable. Check the <a href={siteConfig.socialLinks.github} target="_blank" class="text-accent hover:underline">GitHub Profile</a> directly.</p>
      </div>
    )}
  </div>

  <style>
    .block-panel:hover {
      border-color: var(--accent-primary);
    }
  </style>
</Layout>
