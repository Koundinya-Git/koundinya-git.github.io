---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import Typewriter from '../components/Typewriter';
import { ArrowRight, Book, FlaskConical, Code } from 'lucide-react';

const terminalLines = [
  "root@anti-code:~# ./manifesto.sh",
  "",
  "> Modern software is bloated.",
  "> We rely on layers of abstractions we don't understand.",
  "> It's time to build from the ground up.",
  "> ",
  "> Welcome to the Digital World of Koundinya Gajulapalli.",
  "> Status: ONLINE",
];
---

<Layout>
  <div style="padding-top: 4rem; padding-bottom: 2rem;">
    <!-- Hero Section: Terminal Window -->
    <section style="margin-bottom: 3rem; display: flex; justify-content: center;">
      <div style="width: 100%; max-width: 800px; background-color: #0d1117; border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        
        {/* Terminal Header */}
        <div style="background-color: #161b22; border-bottom: 1px solid var(--border-color); padding: 0.5rem 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ff5f56;"></div>
          <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ffbd2e;"></div>
          <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #27c93f;"></div>
          <div class="mono" style="margin-left: 1rem; font-size: 0.85rem; color: #8b949e;">root@anti-code:~#</div>
        </div>

        {/* Terminal Body */}
        <div style="padding: 1.5rem; min-height: 300px;">
          <Typewriter lines={terminalLines} typingSpeed={40} lineDelay={600} client:load />
        </div>
      </div>
    </section>

    <!-- Quick Navigation -->
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 3rem;">
      <a href="/about" class="block-button">
        <span class="text-accent">>_</span> ABOUT
      </a>
      <a href="/research" class="block-button">
        <FlaskConical size={18} /> RESEARCH
      </a>
      <a href="/projects" class="block-button">
        <Book size={18} /> PROJECTS
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <!-- About Snapshot -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-accent">>_ ABOUT</h2>
        <p class="text-secondary mb-4" style="line-height: 1.6;">
          {siteConfig.description}
        </p>
        <a href="/about" class="mono text-primary flex items-center gap-1 hover:text-accent">
          Read full profile <ArrowRight size={16} />
        </a>
      </section>
      
      <!-- Currently Working On -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-accent">>_ CURRENTLY</h2>
        <ul class="text-secondary mono" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <li>> Building a digital world</li>
          <li>> Researching quantum gravity</li>
          <li>> Writing about theoretical physics</li>
        </ul>
        <a href="/now" class="mono text-primary flex items-center gap-1 hover:text-accent" style="margin-top: 1rem;">
          See /now <ArrowRight size={16} />
        </a>
      </section>
    </div>

    <!-- Latest Activity Dashboard -->
    <section class="block-panel" style="margin-bottom: 2rem;">
      <h2 class="mono mb-4 text-accent">>_ LATEST_ACTIVITY</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
        
        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <Code size={18} /> CODE
          </h3>
          <p class="text-secondary text-sm mb-2">Synced automatically from GitHub.</p>
          <a href="/github" class="mono text-accent text-sm hover:underline">View all repositories →</a>
        </div>

        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <FlaskConical size={18} /> RESEARCH
          </h3>
          <p class="text-secondary text-sm mb-2">Latest publications and notes.</p>
          <a href="/research" class="mono text-accent text-sm hover:underline">View all research →</a>
        </div>

        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <Book size={18} /> WRITING
          </h3>
          <p class="text-secondary text-sm mb-2">Thoughts and blog posts.</p>
          <a href="/blog" class="mono text-accent text-sm hover:underline">View all posts →</a>
        </div>

      </div>
    </section>

  </div>
</Layout>
