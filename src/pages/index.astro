---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import Typewriter from '../components/Typewriter';
import Globe from '../components/Globe';
import { ArrowRight, Book, FlaskConical, Code, Terminal } from 'lucide-react';

const terminalLines = [
  "root@anti-code:~# ./manifesto.sh",
  "",
  "> Governments seek control. Corporations seek influence. Question both.",
  "> The modern web is a cage of surveillance and bloated abstractions.",
  "> They trade your autonomy for the illusion of convenience.",
  "> It's time to build from the ground up.",
  "> ",
  "> Welcome to the Digital World of Koundinya Gajulapalli.",
  "> Status: ONLINE",
];

// Fetch Latest GitHub Repo
let latestRepo = null;
try {
  const res = await fetch(`https://api.github.com/users/${siteConfig.githubUsername}/repos?sort=updated&per_page=1`, {
    headers: { 'User-Agent': siteConfig.githubUsername }
  });
  if (res.ok) {
    const repos = await res.json();
    if (repos.length > 0) latestRepo = repos[0];
  }
} catch (e) {
  // Silent fail for index page, fallback to link
}

// Fetch Latest Publication
let latestPub = null;
try {
  const res = await fetch(`https://pub.orcid.org/v3.0/${siteConfig.orcidId}/works`, {
    headers: { 'Accept': 'application/json' }
  });
  if (res.ok) {
    const data = await res.json();
    const works = data.group || [];
    if (works.length > 0) {
      const summary = works[0]['work-summary'][0];
      latestPub = {
        title: summary.title.title.value,
        url: summary.url ? summary.url.value : (summary['external-ids']?.['external-id']?.find((id: any) => id['external-id-type'] === 'doi') ? `https://doi.org/${summary['external-ids']['external-id'].find((id: any) => id['external-id-type'] === 'doi')['external-id-value']}` : null)
      };
    }
  }
} catch (e) {
  // Silent fail
}
---

<Layout>
  <div style="padding-top: 4rem; padding-bottom: 2rem;">
    <!-- Hero Section: Terminal and Globe -->
    <section style="margin-bottom: 4rem; margin-top: 2rem;">
      <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem;">
        <div style="width: 48px; height: 48px; background: var(--accent-primary); border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 15px var(--accent-primary);">
          <Terminal size={24} color="black" />
        </div>
        <div>
          <h1 class="mono m-0" style="font-size: 2.5rem; letter-spacing: -1px;">
            Koundinya-Git
          </h1>
          <p class="mono text-accent m-0" style="font-size: 1rem;">>>_ sys.admin & dev</p>
        </div>
      </div>
      
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%;">
        <!-- Terminal Window -->
        <div style="width: 100%; max-width: 100%; background-color: #0d1117; border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
          {/* Terminal Header */}
          <div style="background-color: #161b22; border-bottom: 1px solid var(--border-color); padding: 0.5rem 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ff5f56;"></div>
            <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ffbd2e;"></div>
            <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #27c93f;"></div>
            <div class="mono" style="margin-left: 1rem; font-size: 0.85rem; color: #8b949e;">root@koundinya-git:~#</div>
          </div>

          {/* Terminal Body */}
          <div style="padding: 1.5rem; min-height: 250px;">
            <Typewriter lines={terminalLines} typingSpeed={40} lineDelay={600} client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Navigation -->
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 3rem;">
      <a href="/about" class="block-button">
        <span class="text-accent">>_</span> ABOUT
      </a>
      <a href="/research" class="block-button">
        <FlaskConical size={18} /> RESEARCH
      </a>
      <a href="/projects" class="block-button">
        <Book size={18} /> PROJECTS
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <!-- About Snapshot -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-accent">>_ ABOUT</h2>
        <p class="text-secondary mb-4" style="line-height: 1.6;">
          {siteConfig.description}
        </p>
        <a href="/about" class="mono text-primary flex items-center gap-1 hover:text-accent">
          Read full profile <ArrowRight size={16} />
        </a>
      </section>
      
      <!-- Currently Working On -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-accent">>_ CURRENTLY</h2>
        <ul class="text-secondary mono" style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
          <li>> Building a digital world</li>
          <li>> Researching quantum gravity</li>
          <li>> Writing about theoretical physics</li>
        </ul>
        <a href="/now" class="mono text-primary flex items-center gap-1 hover:text-accent" style="margin-top: 1rem;">
          See /now <ArrowRight size={16} />
        </a>
      </section>
    </div>



    <!-- Latest Activity Dashboard -->
    <section class="block-panel" style="margin-bottom: 2rem;">
      <h2 class="mono mb-4 text-accent">>_ LATEST_ACTIVITY</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
        
        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <Code size={18} /> CODE
          </h3>
          {latestRepo ? (
            <div class="mb-3" style="background: rgba(255,255,255,0.03); padding: 0.75rem; border-left: 2px solid var(--accent-primary);">
              <p class="mono text-sm text-primary mb-1">{latestRepo.name}</p>
              <p class="text-xs text-secondary mb-2">{latestRepo.description?.substring(0, 50)}{latestRepo.description?.length > 50 ? '...' : ''}</p>
              <a href={latestRepo.html_url} target="_blank" rel="noopener noreferrer" class="text-xs mono text-accent hover:underline">View repo →</a>
            </div>
          ) : (
            <p class="text-secondary text-sm mb-2">Synced automatically from GitHub.</p>
          )}
          <a href="/projects" class="mono text-accent text-sm hover:underline">View all repositories →</a>
        </div>

        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <FlaskConical size={18} /> RESEARCH
          </h3>
          {latestPub ? (
            <div class="mb-3" style="background: rgba(255,255,255,0.03); padding: 0.75rem; border-left: 2px solid var(--accent-primary);">
              <p class="mono text-sm text-primary mb-1">{latestPub.title.substring(0, 50)}{latestPub.title.length > 50 ? '...' : ''}</p>
              {latestPub.url ? (
                <a href={latestPub.url} target="_blank" rel="noopener noreferrer" class="text-xs mono text-accent hover:underline">Read paper →</a>
              ) : (
                <span class="text-xs text-secondary mono">Available on ORCiD</span>
              )}
            </div>
          ) : (
            <p class="text-secondary text-sm mb-2">Latest publications and notes.</p>
          )}
          <a href="/research" class="mono text-accent text-sm hover:underline">View all research →</a>
        </div>

        <div>
          <h3 class="mono text-primary mb-2 flex items-center gap-2">
            <Book size={18} /> WRITING
          </h3>
          <p class="text-secondary text-sm mb-2">Thoughts and blog posts.</p>
          <a href="/blog" class="mono text-accent text-sm hover:underline">View all posts →</a>
        </div>

      </div>
    </section>

  </div>
</Layout>
