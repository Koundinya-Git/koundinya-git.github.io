---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import { BookMarked, PenTool } from 'lucide-react';
---

<Layout title={`Guestbook | ${siteConfig.name}`}>
  <div style="padding-top: 6rem; padding-bottom: 4rem; max-width: 800px; margin: 0 auto;">
    
    <header style="margin-bottom: 3rem; text-align: center;">
      <h1 class="mono text-primary mb-2 flex items-center justify-center gap-2" style="font-size: 2.5rem;">
        <BookMarked size={32} class="text-accent" /> /guestbook
      </h1>
      <p class="text-secondary mono">Leave a mark in this digital world.</p>
    </header>

    <div class="block-panel" style="margin-bottom: 2rem;">
      <h2 class="mono text-accent mb-4 flex items-center gap-2">
        <PenTool size={20} /> Sign the Guestbook
      </h2>
      <p class="text-secondary mb-4 text-sm">
        This is a static placeholder for the guestbook. A real implementation would require a backend service or database like Firebase, Supabase, or a serverless function with a key-value store.
      </p>
      <form style="display: flex; flex-direction: column; gap: 1rem; opacity: 0.5; pointer-events: none;">
        <input type="text" placeholder="Your Name" class="mono text-primary" style="background: var(--surface-color-light); border: 1px solid var(--surface-color-border); padding: 0.75rem; border-radius: var(--border-radius); outline: none;" disabled />
        <textarea placeholder="Your Message" rows="3" class="mono text-primary" style="background: var(--surface-color-light); border: 1px solid var(--surface-color-border); padding: 0.75rem; border-radius: var(--border-radius); outline: none; resize: vertical;" disabled></textarea>
        <button type="button" class="block-button" disabled>SUBMIT</button>
      </form>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h3 class="mono text-primary mb-2">Recent Signatures</h3>
      
      <div class="block-panel" style="padding: 1.5rem; border-left: 2px solid var(--accent-primary);">
        <p class="text-secondary mb-2" style="font-size: 1.1rem;">"Great digital world! I love the dynamic environment."</p>
        <div class="flex justify-between items-center text-xs mono text-secondary">
          <span class="text-primary font-bold">Wanderer</span>
          <span>August 2026</span>
        </div>
      </div>
      
      <div class="block-panel" style="padding: 1.5rem; border-left: 2px solid var(--accent-primary);">
        <p class="text-secondary mb-2" style="font-size: 1.1rem;">"The Minecraft aesthetic is super cool. Good luck with the quantum gravity research!"</p>
        <div class="flex justify-between items-center text-xs mono text-secondary">
          <span class="text-primary font-bold">Fellow Physicist</span>
          <span>July 2026</span>
        </div>
      </div>
    </div>
    
  </div>
</Layout>
