---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import { Telescope } from 'lucide-react';
---

<Layout title={`Astronomy | ${siteConfig.name}`}>
  <div style="padding-top: 6rem; padding-bottom: 4rem; max-width: 800px; margin: 0 auto;">
    <header style="margin-bottom: 3rem; text-align: center;">
      <h1 class="mono text-primary mb-2 flex items-center justify-center gap-2" style="font-size: 2.5rem;">
        <Telescope size={32} class="text-accent" /> /astronomy
      </h1>
      <p class="text-secondary mono">Astrophotography and celestial observations.</p>
    </header>

    <div class="block-panel text-center" style="padding: 3rem;">
      <p class="text-secondary mono">The observatory dome is currently closed. Awaiting clear skies to capture new data.</p>
    </div>
  </div>
</Layout>
