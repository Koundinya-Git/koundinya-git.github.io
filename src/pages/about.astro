---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import { User, Brain, Code, Microscope, Target } from 'lucide-react';
---

<Layout title={`About | ${siteConfig.name}`}>
  <div style="padding-top: 6rem; padding-bottom: 4rem;">
    
    <div style="display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; margin: 0 auto;">
      
      <!-- Player Profile / HUD -->
      <section class="block-panel" style="border-color: var(--accent-primary);">
        <h1 class="mono text-accent mb-4 flex items-center gap-2">
          <User size={28} /> PLAYER PROFILE
        </h1>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
          <div class="block-panel" style="background: rgba(0,0,0,0.3); padding: 1rem;">
            <p class="mono text-secondary text-sm mb-1">USERNAME</p>
            <p class="mono font-bold text-lg">{siteConfig.nickname}</p>
          </div>
          <div class="block-panel" style="background: rgba(0,0,0,0.3); padding: 1rem;">
            <p class="mono text-secondary text-sm mb-1">LEVEL</p>
            <p class="mono font-bold text-lg text-accent">22</p>
          </div>
          <div class="block-panel" style="background: rgba(0,0,0,0.3); padding: 1rem;">
            <p class="mono text-secondary text-sm mb-1">CLASS</p>
            <p class="mono font-bold text-lg">Theoretical Physicist</p>
          </div>
          <div class="block-panel" style="background: rgba(0,0,0,0.3); padding: 1rem;">
            <p class="mono text-secondary text-sm mb-1">FACTION</p>
            <p class="mono font-bold text-lg">Independent Researcher</p>
          </div>
        </div>

        <div style="margin-bottom: 1rem;">
          <div class="flex justify-between mono text-sm mb-1">
            <span>XP TO NEXT LEVEL</span>
            <span class="text-accent">14,200 / 20,000</span>
          </div>
          <div style="width: 100%; height: 10px; background: rgba(0,0,0,0.5); border-radius: 2px; border: 1px solid var(--surface-color-border);">
            <div style="width: 71%; height: 100%; background: var(--accent-primary); box-shadow: 0 0 10px var(--glow-color);"></div>
          </div>
        </div>
      </section>

      <!-- Who I Am -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-primary flex items-center gap-2">
          <Brain size={24} /> Who I Am
        </h2>
        <div class="text-secondary" style="line-height: 1.8; font-size: 1.1rem; display: flex; flex-direction: column; gap: 1rem;">
          <p>
            I am <strong>{siteConfig.name}</strong>, though most call me <strong>{siteConfig.nickname}</strong>.
            I am a student, researcher, programmer, builder, musician, gamer, and aspiring theoretical physicist.
          </p>
          <p>
            My work is driven by an intense curiosity about how the universe fundamentally operates. 
            I spend my time oscillating between deriving equations for quantum gravity, building unconventional software, and gazing at the stars through my telescope.
          </p>
        </div>
      </section>

      <!-- What I Study -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-primary flex items-center gap-2">
          <Microscope size={24} /> What I Study
        </h2>
        <ul class="text-secondary mono" style="list-style-type: '>'; padding-left: 1.5rem; line-height: 2;">
          <li style="padding-left: 0.5rem;">Theoretical physics</li>
          <li style="padding-left: 0.5rem;">Cosmology</li>
          <li style="padding-left: 0.5rem;">Quantum gravity</li>
          <li style="padding-left: 0.5rem;">Astrophysics</li>
          <li style="padding-left: 0.5rem;">Mathematics</li>
          <li style="padding-left: 0.5rem;">Computer science</li>
        </ul>
      </section>

      <!-- What I Build -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-primary flex items-center gap-2">
          <Code size={24} /> What I Build
        </h2>
        <p class="text-secondary mb-4" style="line-height: 1.8;">
          I construct digital and physical systems. I love low-level programming, exploring operating system kernels, designing complex electronics, and creating interactive web experiences (like this digital world).
        </p>
        <a href="/projects" class="block-button">VIEW PROJECTS</a>
      </section>

      <!-- Future Goals -->
      <section class="block-panel">
        <h2 class="mono mb-4 text-primary flex items-center gap-2">
          <Target size={24} /> Future Goals
        </h2>
        <p class="text-secondary" style="line-height: 1.8;">
          To formulate a mathematically consistent framework that unifies general relativity and quantum mechanics, while building open-source tools that empower other researchers to explore the cosmos.
        </p>
      </section>

    </div>
  </div>
</Layout>
