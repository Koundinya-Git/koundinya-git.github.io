---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../siteConfig';
import { Monitor, Cpu, Code2 } from 'lucide-react';
---

<Layout title={`Tools | ${siteConfig.name}`}>
  <div style="padding-top: 6rem; padding-bottom: 4rem; max-width: 800px; margin: 0 auto;">
    
    <header style="margin-bottom: 3rem;">
      <h1 class="mono text-primary mb-2 flex items-center gap-2" style="font-size: 2.5rem;">
        <Monitor size={32} class="text-accent" /> >_ /tools
      </h1>
      <p class="text-secondary mono">Hardware and software I use daily.</p>
    </header>

    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <section class="block-panel">
        <h2 class="mono text-accent mb-4 flex items-center gap-2">
          <Cpu size={24} /> Hardware
        </h2>
        <ul class="text-secondary" style="line-height: 1.8; padding-left: 1.5rem;">
          <li><strong>Primary Workstation:</strong> AMD Ryzen 7 9700X, AMD Radeon RX 9060 XT 16GB, 32GB DDR5-6000, 1TB Kingston NVMe PCIe M.2 SSD, 850W PSU.</li>
          <li><strong>Laptop:</strong> HP Pavilion (11th Gen i5-1135G7 @ 2.40GHz, 16GB RAM 3200MHz, Intel Iris Xe + NVIDIA GeForce MX450).</li>
          <li><strong>Astrophotography:</strong> Nikon 5100D paired with a WilliamOptics RedCat 51 Mk2.5 and iOptron SkyGuider Pro mount.</li>
        </ul>
      </section>

      <section class="block-panel">
        <h2 class="mono text-accent mb-4 flex items-center gap-2">
          <Code2 size={24} /> Software & Tools
        </h2>
        <ul class="text-secondary" style="line-height: 1.8; padding-left: 1.5rem;">
          <li><strong>Editor:</strong> NeoVim (primary), VS Code (heavy/varied use), and Antigravity (for AI).</li>
          <li><strong>Terminal:</strong> Cool-Retro-Term and Default Terminal.</li>
          <li><strong>OS:</strong> Arch Linux + Windows 11 dual-boot.</li>
          <li><strong>Writing:</strong> LaTeX, MS Office, Google Office.</li>
          <li><strong>Languages & Frameworks:</strong> C/C++, Python, Rust, React, HTML/CSS, Astro, Tauri, GNU Octave, PHP, SQL, Fortran, BASIC, and MATLAB.</li>
        </ul>
      </section>
      
    </div>
    
  </div>
</Layout>
